<Project Sdk="Microsoft.NET.Sdk">
  <!-- يتحقق أن Scripts/*.cs تُترجم مع Stride. عدّل Version لنفس نسخة Game Studio عندك. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Scripts\**\*.cs" />
    <PackageReference Include="Stride.Engine" Version="4.*" />
    <PackageReference Include="Stride.Audio" Version="4.*" />
    <PackageReference Include="Stride.Graphics" Version="4.*" />
    <PackageReference Include="Stride.Input" Version="4.*" />
    <PackageReference Include="Stride.Rendering" Version="4.*" />
  </ItemGroup>
</Project>
